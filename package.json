{
  "name": "netzprobe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KISS-Netzprobe Deutschland: statisch hostbar, Simulation im Browser.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:pages": "GITHUB_PAGES=true npm run build",
    "data:factors": "node data/modell/generate-feed-in-factors.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "echarts": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "^4.3.0"
  }
}
