{
  "name": "netzprobe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KISS-Netzprobe Deutschland: React-UI mit Rust-API-Simulation.",
  "scripts": {
    "dev": "bin/dev",
    "vite": "vite --config app/vite.config.ts --host 0.0.0.0",
    "build": "tsc -b && vite build --config app/vite.config.ts",
    "build:pages": "GITHUB_PAGES=true npm run build",
    "data:factors": "node model/erzeugung/einspeisefaktoren-2025/generate.mjs",
    "preview": "vite preview --config app/vite.config.ts --host 0.0.0.0",
    "test": "vitest run test/unit",
    "test:all": "bin/test",
    "test:watch": "vitest test/unit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "echarts": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tailwindcss": "latest",
    "tsx": "latest"
  }
}
