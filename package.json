{
  "name": "netzprobe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KISS-Netzprobe Deutschland: statisch hostbar, Simulation im Browser.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:pages": "GITHUB_PAGES=true npm run build",
    "data:factors": "node data/erzeugung/einspeisefaktoren-2025/generate.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "simulate": "tsx test/scenarios/run.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "echarts": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tailwindcss": "latest",
    "tsx": "latest"
  }
}
