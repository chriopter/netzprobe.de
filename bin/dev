#!/usr/bin/env bash
# Startet API (auto-restart bei Rust/JSON-Änderungen) und Vite-Dev-Server.
# Watcht server/ und model/ — bei Änderung an *.rs, *.toml oder *.json
# wird der API-Server (cargo run) neu gestartet.
set -euo pipefail
cd "$(dirname "$0")/.."

api_pid=""

start_api() {
  echo "[bin/dev] Starte API (cargo run)..."
  cargo run --manifest-path server/Cargo.toml &
  api_pid="$!"
}

stop_api() {
  if [[ -n "$api_pid" ]] && kill -0 "$api_pid" 2>/dev/null; then
    kill "$api_pid" 2>/dev/null || true
    wait "$api_pid" 2>/dev/null || true
  fi
  api_pid=""
}

# Signatur der überwachten Quellen (mtime + Pfad), für den Polling-Fallback.
watch_signature() {
  find server model Cargo.toml Cargo.lock -type f \
    \( -name '*.rs' -o -name '*.toml' -o -name '*.json' -o -name '*.lock' \) \
    -not -path '*/target/*' -not -path '*/node_modules/*' \
    -printf '%T@ %p\n' 2>/dev/null | sort
}

watch_loop() {
  if command -v inotifywait >/dev/null 2>&1; then
    while true; do
      if ! inotifywait -qq -e modify,create,delete,move -r \
          --exclude '(target|node_modules|dist|\.git|tsbuildinfo)' \
          server model Cargo.toml Cargo.lock 2>/dev/null; then
        sleep 0.5
        continue
      fi
      echo ""
      echo "[bin/dev] Änderung erkannt — restarte API..."
      stop_api
      sleep 0.3
      start_api
    done
    return 0
  fi
  # Fallback ohne inotify-tools: Polling der Datei-mtimes (alle 2 s). Etwas
  # weniger effizient, aber der API-Server bleibt nie auf altem Rust-Stand.
  echo "[bin/dev] inotifywait nicht gefunden — Polling-Fallback (2 s) für API-Restart aktiv."
  echo "[bin/dev] Effizienter mit: pacman -S inotify-tools (Arch) bzw. apt install inotify-tools (Debian/Ubuntu)."
  local last
  last="$(watch_signature)"
  while true; do
    sleep 2
    local now
    now="$(watch_signature)"
    if [[ "$now" != "$last" ]]; then
      echo ""
      echo "[bin/dev] Änderung erkannt (Polling) — restarte API..."
      stop_api
      sleep 0.3
      start_api
      last="$now"
    fi
  done
}

cleanup() {
  stop_api
  jobs -p | xargs -r kill 2>/dev/null || true
}
trap cleanup EXIT INT TERM

start_api
watch_loop &
# DEP0205 stammt aus Vites ESM-Loader (module.register() unter Node >= 26),
# nicht aus unserem Code — stummschalten, bis Upstream auf registerHooks() ist.
NODE_OPTIONS="${NODE_OPTIONS:-} --disable-warning=DEP0205" npm run vite
