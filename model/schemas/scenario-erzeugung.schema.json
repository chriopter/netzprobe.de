{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://netzprobe.de/schemas/scenario-erzeugung.schema.json",
  "title": "Erzeugungs-Szenario",
  "allOf": [{ "$ref": "./_common.schema.json" }],
  "properties": {
    "domain": { "const": "erzeugung" },
    "kind": { "const": "scenario" },
    "parameters": {
      "type": "object",
      "required": ["mode", "installed2025GW", "defaultInstalledGW", "emissions"],
      "properties": {
        "mode": { "type": "string", "enum": ["variable-re", "baseload", "dispatchable"] },
        "installed2025GW": { "type": "number" },
        "defaultInstalledGW": { "type": "number" },
        "minInstalledGW": { "type": "number" },
        "maxInstalledGW": { "type": "number" },
        "stepGW": { "type": "number" },
        "emissions": {
          "type": "object",
          "required": ["co2eGperKWh"],
          "properties": {
            "co2eGperKWh": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  }
}
