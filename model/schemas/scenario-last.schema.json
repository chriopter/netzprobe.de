{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://netzprobe.de/schemas/scenario-last.schema.json",
  "title": "Last-Szenario (e100-*)",
  "allOf": [{ "$ref": "./_common.schema.json" }],
  "properties": {
    "domain": { "const": "last" },
    "kind": { "const": "scenario" },
    "parameters": {
      "type": "object",
      "properties": {
        "referenceYear": { "type": "integer" },
        "distribution": { "type": "string", "enum": ["hourly-profile", "heating-degree-days"] },
        "hourlyProfile": {
          "type": "object",
          "required": ["multipliers"],
          "properties": {
            "source": { "type": "string" },
            "sourceUrls": { "type": "array", "items": { "type": "string", "format": "uri" } },
            "multipliers": {
              "type": "array",
              "minItems": 24,
              "maxItems": 24,
              "items": { "type": "number" }
            }
          }
        },
        "degreeDayProfile": { "type": "object" },
        "referenceScales": { "type": "object" }
      }
    }
  }
}
